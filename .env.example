# Copy to .env next to docker-compose.yml; values are not baked into the image.

# Required.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=ddns-by-dnspod

# What the UI calls the provider, and a logout URL for providers without a
# standard end_session_endpoint. Empty hides the sign-out entry.
OIDC_PROVIDER_NAME=OIDC
OIDC_LOGOUT_URL=

# Imported on the first start only. Leave empty to add accounts in the UI.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_USER=
NTFY_PASS=

# Base64 32 bytes. Empty generates data/secret.key; back it up with the database.
DDNS_CRYPTO_KEY=

# Host port published on loopback.
DDNS_PORT=8080

# Also sets the local hour of the daily certificate check.
TZ=Asia/Shanghai
