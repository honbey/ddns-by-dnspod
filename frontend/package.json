{
  "name": "ddns-by-dnspod-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "openapi-typescript ../backend/openapi.yml -o src/api-types.gen.ts",
    "types": "openapi-typescript ../backend/openapi.yml -o src/api-types.gen.ts",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/write-runtime-config.mjs",
    "preview": "vite preview",
    "pretypecheck": "openapi-typescript ../backend/openapi.yml -o src/api-types.gen.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
